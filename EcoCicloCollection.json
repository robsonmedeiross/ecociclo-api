{
  "openapi": "3.0.4",
  "info": {
    "title": "EcoCiclo.API",
    "version": "1.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/coletas": {
      "get": {
        "tags": [
          "Coletas"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Coletas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgendamentoColeta"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AgendamentoColeta"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AgendamentoColeta"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/pontos-coleta/alerta": {
      "post": {
        "tags": [
          "PontosColeta"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "volumeAtual",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "double"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/pontos-coleta/otimizacao": {
      "get": {
        "tags": [
          "PontosColeta"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/pontos-coleta": {
      "post": {
        "tags": [
          "PontosColeta"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PontoColeta"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PontoColeta"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PontoColeta"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgendamentoColeta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "empresaUsuario": {
            "type": "string",
            "nullable": true
          },
          "endereco": {
            "type": "string",
            "nullable": true
          },
          "pesoEstimadoKg": {
            "type": "number",
            "format": "double"
          },
          "dataAgendamento": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PontoColeta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "localizacao": {
            "type": "string",
            "nullable": true
          },
          "tipoResiduo": {
            "type": "string",
            "nullable": true
          },
          "capacidadeMaximaKg": {
            "type": "number",
            "format": "double"
          },
          "capacidadeAtualKg": {
            "type": "number",
            "format": "double"
          },
          "precisaColeta": {
            "type": "boolean"
          },
          "ultimaSincronizacao": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  }
}